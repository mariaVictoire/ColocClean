# Copier vers .env et adapter les valeurs

# --- Base de données (local OU Neon pour Vercel) ---
# Local :
# DATABASE_URL="postgresql://coloclean:coloclean@localhost:5432/coloclean?schema=public"
# DIRECT_URL="postgresql://coloclean:coloclean@localhost:5432/coloclean?schema=public"

# Neon (recommandé avec Vercel) :
# DATABASE_URL = connection pooler (-pooler dans l'hôte)
# DIRECT_URL   = connection directe (migrations Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-cle-secrete-longue"
# Dev :
AUTH_URL="http://localhost:3000"
# Prod Vercel (ex.) :
# AUTH_URL="https://coloclean.vercel.app"

# Stockage photos :
# - local : OK en développement uniquement (filesystem éphémère sur Vercel)
# - cloudinary | azure | s3 | vercel-blob : pour la production
STORAGE_PROVIDER="local"

# Optionnel — Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optionnel — Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Optionnel — Azure Blob
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# Optionnel — Amazon S3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cron Vercel — doit correspondre à l'en-tête Authorization Bearer
CRON_SECRET="remplacer-par-un-secret-cron"
