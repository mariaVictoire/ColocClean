# Copier vers .env et adapter les valeurs

# --- Base de données : Supabase (recommandé pour tester) ---
# Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true
# DIRECT_URL   = Direct connection (port 5432) — requis pour prisma migrate
#
# Remplace [PASSWORD] et [PROJECT_REF] (et la région du pooler si besoin).
# Si le mot de passe contient des caractères spéciaux, URL-encode-le
# (ex. @ → %40, # → %23).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Alternative locale (Docker) ---
# DATABASE_URL="postgresql://coloclean:coloclean@localhost:5432/coloclean?schema=public"
# DIRECT_URL="postgresql://coloclean:coloclean@localhost:5432/coloclean?schema=public"

# --- Alternative Neon ---
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-cle-secrete-longue"
# Dev (adapter le port si Next en utilise un autre, ex. 3002) :
AUTH_URL="http://localhost:3000"
# Prod Vercel (ex.) :
# AUTH_URL="https://coloclean.vercel.app"

# Stockage photos (optionnel — non utilisé si envoi WhatsApp direct)
# Le flux actuel envoie la photo au WhatsApp du bailleur depuis le téléphone.
STORAGE_PROVIDER="local"

# Optionnel — Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optionnel — Azure Blob
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# Optionnel — Amazon S3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cron Vercel — doit correspondre à l'en-tête Authorization Bearer
CRON_SECRET="remplacer-par-un-secret-cron"
